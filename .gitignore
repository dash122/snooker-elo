# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.codex-*.log

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
next-env.d.ts
*.tsbuildinfo
/dist/
/.wrangler/
/outputs/
/work/
.claude/worktrees/

# supabase CLI local state
supabase/.branches/
supabase/.temp/

# Design canvases: the .dc.html artboards and canvas.json in .design/ are the
# source and are tracked. The seeded page beside them is a ~2.5 MB build artifact
# with the whole canvas editor baked in, regenerated by the /design helper on
# every change — never commit one.
/.design/**/*.html
!/.design/**/*.dc.html
